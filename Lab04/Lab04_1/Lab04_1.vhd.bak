library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity Lab04_1 is
    Port ( SW : in STD_LOGIC_VECTOR(3 downto 0);
           HEX0 : out STD_LOGIC_VECTOR(6 downto 0);
           HEX1 : out STD_LOGIC_VECTOR(6 downto 0)
    );
end Lab04_1;

architecture Behavioral of Lab04_1 is
begin
    with SW select
        HEX0 <= "1000000" when "0000", --0 
                "1111001" when "0001", --1
                "0100100" when "0010", --2
                "0110000" when "0011", --3
                "0011001" when "0100", --4
                "0010010" when "0101", --5
                "0000010" when "0110", --6
                "1111000" when "0111", --7
                "0000000" when "1000", --8
                "0010000" when "1001", --9
                "1000000" when "1010", --10
                "1111001" when "1011", --11
                "0100100" when "1100", --12
                "0110000" when "1101", --13
                "0011001" when "1110", --14
                "0010010" when "1111", --15
                "1111111" when others;

    with SW select
        HEX1 <= "1111111" when "0000", --0 
                "1111111" when "0001", --1
                "1111111" when "0010", --2
                "1111111" when "0011", --3
                "1111111" when "0100", --4
                "1111111" when "0101", --5
                "1111111" when "0110", --6
                "1111111" when "0111", --7
                "1111111" when "1000", --8
                "1111111" when "1001", --9
                "1111001" when "1010", --10
                "1111001" when "1011", --11
                "1111001" when "1100", --12
                "1111001" when "1101", --13
                "1111001" when "1110", --14
                "1111001" when "1111", --15
                "1111111" when others;

end Behavioral;